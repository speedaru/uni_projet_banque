<%- include('partials/header', { titre }) %>
<%- include('partials/page-titre', {
  icone: 'wallet',
  sousTitre: isClient
    ? 'Solde et transactions de votre entreprise par date de valeur.'
    : 'Soldes et transactions de vos comptes clients par date de valeur.',
}) %>

<%# Critères de sélection (spécifications, fonction 2.1) %>
<form method="get" class="carte filtres">
  <div class="champ">
    <label for="siren">N° de SIREN</label>
    <div class="champ-icone">
      <%- icon('hash', 18) %>
      <% if (isClient) { %>
      <input id="siren" value="<%= clientSiren %>" readonly />
      <% } else { %>
      <input id="siren" name="siren" value="<%= filters.siren ?? '' %>" placeholder="Tous" inputmode="numeric" maxlength="11" />
      <% } %>
    </div>
  </div>
  <div class="champ">
    <label for="raisonSociale">Raison sociale</label>
    <div class="champ-icone">
      <%- icon('building', 18) %>
      <% if (isClient) { %>
      <input id="raisonSociale" value="<%= clientRaisonSociale %>" readonly />
      <% } else { %>
      <input id="raisonSociale" name="raisonSociale" value="<%= filters.raisonSociale ?? '' %>" placeholder="Toutes" maxlength="20" />
      <% } %>
    </div>
  </div>
  <div class="champ">
    <label for="dateValeur">Date de valeur</label>
    <div class="champ-icone">
      <%- icon('calendar', 18) %>
      <input id="dateValeur" name="dateValeur" type="date" value="<%= filters.dateValeur ?? '' %>" />
    </div>
  </div>
  <input type="hidden" name="tri" value="<%= sort.key %>" />
  <input type="hidden" name="ordre" value="<%= sort.order %>" />
  <div class="actions">
    <button type="submit" class="bouton bouton-principal"><%- icon('search', 18) %> Rechercher</button>
    <a class="bouton bouton-fantome" href="?"><%- icon('reset', 18) %> Réinitialiser</a>
  </div>
</form>

<% if (errors.length > 0) { %>
<div class="alerte alerte-erreur" role="alert">
  <%- icon('info', 20) %>
  <ul>
    <% errors.forEach((error) => { %>
    <li><%= error %></li>
    <% }) %>
  </ul>
</div>
<% } else { %>
<%
  // Indicateurs affichés au-dessus du tableau
  const negativeCount = rows.filter((row) => row.totalAmount < 0).length;
%>
<section class="indicateurs">
  <div class="indicateur">
    <span class="indicateur-icone teinte-0"><%- icon('wallet', 22) %></span>
    <span class="indicateur-libelle">Solde total</span>
    <strong class="<%= totals.totalAmount < 0 ? 'texte-negatif' : '' %>"><%= formatAmount(totals.totalAmount) %> €</strong>
  </div>
  <div class="indicateur">
    <span class="indicateur-icone teinte-1"><%- icon('card', 22) %></span>
    <span class="indicateur-libelle">Transactions</span>
    <strong><%= totals.transactionCount.toLocaleString('fr-FR') %></strong>
  </div>
  <div class="indicateur">
    <span class="indicateur-icone <%= negativeCount > 0 ? 'teinte-danger' : 'teinte-2' %>"><%- icon('alert', 22) %></span>
    <span class="indicateur-libelle">Comptes en négatif</span>
    <strong><%= negativeCount %></strong>
  </div>
</section>

<section class="carte">
  <div class="carte-entete">
    <h2 class="carte-titre">
      <%- icon('calendar', 20) %>
      <% if (filters.dateValeur) { %>
      Annonces du <%= formatIsoDate(filters.dateValeur) %>
      <% } else { %>
      Solde global (toutes dates de valeur)
      <% } %>
    </h2>
    <span class="pastille nombre-resultats"><%= rows.length %> compte<%= rows.length > 1 ? 's' : '' %></span>
  </div>

  <% if (rows.length === 0) { %>
  <div class="etat-vide etat-vide-compact">
    <img src="/img/illustration-a-venir.svg" alt="" width="180" height="125" />
    <p>Aucune annonce pour ces critères.</p>
  </div>
  <% } else { %>
  <%
    // Flèche indiquant la colonne triée
    const arrow = (key) => (sort.key === key ? (sort.order === 'asc' ? ' ▲' : ' ▼') : '');
  %>
  <div class="tableau-conteneur">
    <table class="tableau">
      <thead>
        <tr>
          <th><a href="<%= sortUrl('siren') %>" class="tri<%= sort.key === 'siren' ? ' tri-actif' : '' %>">N° de SIREN<%= arrow('siren') %></a></th>
          <th>Raison sociale</th>
          <th class="nombre">Nombre transactions</th>
          <th>Devise</th>
          <th class="nombre"><a href="<%= sortUrl('montant') %>" class="tri<%= sort.key === 'montant' ? ' tri-actif' : '' %>">Montant total<%= arrow('montant') %></a></th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row) => { %>
        <tr>
          <td><%= row.siren %></td>
          <td><%= row.raisonSociale %></td>
          <td class="nombre"><%= row.transactionCount %></td>
          <td><span class="devise"><%= row.devise %></span></td>
          <%# Solde négatif affiché en rouge (Epic 1, US6) %>
          <td class="nombre<%= row.totalAmount < 0 ? ' negatif' : '' %>"><%= formatAmount(row.totalAmount) %></td>
        </tr>
        <% }) %>
      </tbody>
      <% if (rows.length > 1) { %>
      <tfoot>
        <tr>
          <th colspan="2">Total</th>
          <th class="nombre"><%= totals.transactionCount %></th>
          <th><span class="devise">EUR</span></th>
          <th class="nombre<%= totals.totalAmount < 0 ? ' negatif' : '' %>"><%= formatAmount(totals.totalAmount) %></th>
        </tr>
      </tfoot>
      <% } %>
    </table>
  </div>
  <% } %>
</section>
<% } %>
<%- include('partials/footer') %>

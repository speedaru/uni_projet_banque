<%- include('../partials/header', { titre }) %>
<%- include('../partials/page-titre', {
  icone: 'users',
  sousTitre: "Création et suppression des comptes clients, avec l'accord du Product Owner.",
}) %>

<% if (success) { %>
<p class="alerte alerte-succes" role="status"><%- icon('check', 20) %><span><%= success %></span></p>
<% } %>
<% if (errors.length > 0) { %>
<div class="alerte alerte-erreur" role="alert">
  <%- icon('info', 20) %>
  <ul>
    <% errors.forEach((error) => { %>
    <li><%= error %></li>
    <% }) %>
  </ul>
</div>
<% } %>

<div class="grille-admin">
  <section class="carte">
    <h2 class="carte-titre"><%- icon('plus', 20) %> Créer un compte client</h2>
    <form method="post" action="/admin/comptes" class="formulaire">
      <label for="login">Identifiant</label>
      <div class="champ-icone">
        <%- icon('user', 18) %>
        <input id="login" name="login" value="<%= form.login ?? '' %>" required />
      </div>

      <label for="password">Mot de passe <small>(<%= minPasswordLength %> caractères minimum)</small></label>
      <%- include('../partials/champ-mot-de-passe', { autocomplete: 'new-password', minlength: minPasswordLength }) %>

      <label for="siren">N° de SIREN de l'entreprise</label>
      <div class="champ-icone">
        <%- icon('hash', 18) %>
        <input id="siren" name="siren" value="<%= form.siren ?? '' %>" pattern="\d{9}" maxlength="9" inputmode="numeric" placeholder="9 chiffres" required />
      </div>

      <label for="raisonSociale">Raison sociale</label>
      <div class="champ-icone">
        <%- icon('building', 18) %>
        <input id="raisonSociale" name="raisonSociale" value="<%= form.raisonSociale ?? '' %>" maxlength="20" required />
      </div>

      <%# Case « Accord Product Owner » exigée par les spécifications (fonction 1) %>
      <label class="case-accord">
        <input type="checkbox" name="poAgreement" required />
        <span>Accord du Product Owner</span>
      </label>

      <button type="submit" class="bouton bouton-principal"><%- icon('plus', 18) %> Créer le compte</button>
    </form>
  </section>

  <section class="carte">
    <div class="carte-entete">
      <h2 class="carte-titre"><%- icon('users', 20) %> Comptes existants</h2>
      <span class="pastille"><%= clients.length %></span>
    </div>
    <% if (clients.length === 0) { %>
    <p class="texte-secondaire">Aucun compte client pour le moment.</p>
    <% } else { %>
    <div class="tableau-conteneur">
      <table class="tableau">
        <thead>
          <tr>
            <th>Identifiant</th>
            <th>SIREN</th>
            <th>Raison sociale</th>
            <th>Suppression</th>
          </tr>
        </thead>
        <tbody>
          <% clients.forEach((client) => { %>
          <tr>
            <td>
              <span class="cellule-utilisateur">
                <span class="avatar avatar-petit" aria-hidden="true"><%= client.login.slice(0, 2).toUpperCase() %></span>
                <%= client.login %>
              </span>
            </td>
            <td><%= client.siren %></td>
            <td><%= client.raisonSociale %></td>
            <td>
              <form method="post" action="/admin/comptes/<%= client.id %>/supprimer" class="form-suppression">
                <label class="case-accord case-accord-petite">
                  <input type="checkbox" name="poAgreement" required />
                  <span>Accord PO</span>
                </label>
                <button type="submit" class="bouton bouton-danger bouton-petit" title="Supprimer le compte"><%- icon('trash', 16) %> Supprimer</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</div>
<%- include('../partials/footer') %>

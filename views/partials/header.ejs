<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= titre %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <h1>Portail Web Monétique</h1>
      <% if (locals.navigation) { %>
      <%# Menu de l'espace courant (admin/po/client), fourni par src/routes/roles.ts %>
      <nav class="nav-principale" aria-label="Menu principal">
        <span class="nav-role">Espace <%= roleLabel %></span>
        <ul>
          <% navigation.forEach((link) => { %>
          <li>
            <a href="<%= link.href %>" <%- link.href === currentPath ? 'aria-current="page"' : '' %>><%= link.label %></a>
          </li>
          <% }) %>
        </ul>
        <% if (locals.user) { %>
        <form class="deconnexion" method="post" action="/deconnexion">
          <span><%= user.login %></span>
          <button type="submit">Déconnexion</button>
        </form>
        <% } %>
      </nav>
      <% } %>
    </header>
    <main>

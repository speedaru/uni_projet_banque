# Copier ce fichier en .env et renseigner vos propres valeurs (ne jamais commiter .env)

# Connexion PostgreSQL locale
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/projet_banque?schema=public"

# Secret utilisé pour signer les cookies de session (générer une chaîne aléatoire longue)
# Génération rapide : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Port du serveur Express en local
PORT=3000
